Options -Indexes

RedirectMatch 404 /\.(git|github|env)
RedirectMatch 404 ^/lk/(vendor|storage|app|config|database|routes|tests|bootstrap|resources)/
RedirectMatch 404 ^/lk/jnuaf\.zip$

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{REQUEST_URI} !^/lk/public/
RewriteRule ^(.*)$ /me/public/$1 [R=302,L]
</IfModule>



# JNUAF-SECURITE : fichiers sensibles jamais servis directement

<FilesMatch "^(\.env.*|composer\.(json|lock)|package(-lock)?\.json|artisan|.*\.(log|bak|sql))$">

    Require all denied

</FilesMatch>

<FilesMatch "\.(backup-|avant-)">

    Require all denied

</FilesMatch>

